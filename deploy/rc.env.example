# Copy to a private file outside Git and pass its path as WAYLINE_RC_ENV_FILE.
# RC.5 is a single-instance deployment: the AI budget ledger is a local file and
# must not be shared by multiple app containers without replacing it with a
# transactional store first.
PUBLIC_ORIGIN=https://wayline-staging.example
WEB_ACCESS_PASSWORD=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GMAIL_ORDERS_ENABLED=0
GMAIL_ORDERS_SINGLE_SAMPLE=0
AMAP_WEB_SERVICE_KEY=
API_RATE_LIMIT_PER_MINUTE=60
API_SITE_LIMIT_PER_MINUTE=300
API_FETCH_LIMIT_PER_MINUTE=10
TZ=Asia/Shanghai

# DeepSeek (server-side only). Paid calls stay disabled until the key, a
# positive daily budget and AI_BUDGET_ACKNOWLEDGED=1 are all present.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_THINKING=disabled
AI_DAILY_BUDGET_USD=1
AI_BUDGET_ACKNOWLEDGED=0
AI_DISABLED=0
AI_DAILY_CALL_LIMIT=40
AI_RATE_LIMIT_PER_MINUTE=6
AI_TASK_TOKEN_LIMIT=12000
AI_MAX_OUTPUT_TOKENS=2048
AI_TOOL_ROUND_LIMIT=3
AI_TIMEOUT_MS=25000
# Keep this on a mounted volume so a restart does not reset today's spend.
AI_USAGE_FILE=/data/ai-usage.json
# Private state: account/session vault, calendar credentials and caches.
ACCOUNT_DATA_DIR=/data/accounts
CALENDAR_DATA_DIR=/data/calendar
CALENDAR_PLACES_DIR=/data

# AMap browser key must be restricted to the production domain; the Web
# Service key above stays on the server only.
VITE_AMAP_KEY=
VITE_AMAP_SECURITY_CODE=
