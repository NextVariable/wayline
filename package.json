{
  "name": "wayline",
  "version": "1.0.0-rc.1",
  "private": true,
  "license": "MIT",
  "description": "Calendar-first workspace for business trips, routes, bookings, and schedule risks.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NextVariable/wayline.git"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "type": "module",
  "scripts": {
    "start": "node server/index.mjs",
    "dev": "vite --host 127.0.0.1 --port 3000",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "preview": "vite preview",
    "providers:install": "npm ci --prefix server/provider-runtime --omit=dev --ignore-scripts --no-audit --no-fund",
    "lint": "eslint src --max-warnings 0"
  },
  "dependencies": {
    "@amap/amap-jsapi-loader": "^1.0.1",
    "@vitejs/plugin-react": "^5.0.4",
    "clsx": "^2.1.1",
    "framer-motion": "^12.23.24",
    "ical.js": "^2.2.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-leaflet": "^5.0.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.21",
    "@types/node": "^22.17.2",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "autoprefixer": "^10.4.21",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "typescript": "^7.0.2",
    "typescript-eslint": "8.62.1",
    "vite": "^7.1.7",
    "vitest": "^5.1.0"
  }
}
