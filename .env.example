# Copy to .env.local for local use. Keep real credentials outside Git.
# Browser map keys: restrict allowed domains in the provider console.
VITE_AMAP_KEY=
VITE_AMAP_SECURITY_CODE=
VITE_TIANDITU_TOKEN=
# Server-side credentials are separate from browser credentials.
AMAP_WEB_SERVICE_KEY=
TIANDITU_TOKEN=
# For hosting on a server; keep the local default 127.0.0.1 during development.
# HOST=0.0.0.0
# PORT=8787
# PUBLIC_ORIGIN=https://your-domain.example
# WEB_ACCESS_PASSWORD=choose-a-long-private-preview-password

# Google Calendar web-server OAuth (server only; never use VITE_ for these).
# Enable Calendar API and add http://127.0.0.1:8787/api/calendar/google/callback
# as an authorized redirect URI for local development.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Google sign-in shares GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET with the calendar.
# Also add http://127.0.0.1:8787/api/auth/google/callback as an authorized redirect URI.
# GOOGLE_REDIRECT_URI=https://your-domain.example/api/calendar/google/callback
# GOOGLE_SIGNIN_REDIRECT_URI=https://your-domain.example/api/auth/google/callback
# ACCOUNT_DATA_DIR=/private/path/outside-web-root/wayline-accounts
# Optional read-only travel confirmations (rail, flights and stays). Enable Gmail API in the Google Cloud project.
# GMAIL_ORDERS_ENABLED=1
# For a one-message live acceptance run only:
# GMAIL_ORDERS_SINGLE_SAMPLE=1
# CALENDAR_DATA_DIR=/private/path/outside-web-root/wayline-calendar

# Public research currently uses Tavily keyless access; no search API key needed.
# Paid/authenticated search providers are not selected by the running server.
# RESEARCH_DATA_DIR=/private/path/outside-web-root/wayline-research

# Public API limits per caller. The anonymous search, route and resource routes spend
# your map quota, so keep them on when the site is reachable by others.
# API_RATE_LIMIT_PER_MINUTE=90
# API_FETCH_LIMIT_PER_MINUTE=10
# API_SITE_LIMIT_PER_MINUTE=1500
# Set to 1 only behind one trusted reverse proxy that appends the client address to
# X-Forwarded-For. Without it every caller is identified by the socket address.
# TRUST_PROXY=1
